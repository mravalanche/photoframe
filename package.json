{
  "name": "photoframe-ui",
  "private": true,
  "version": "2.0.0-dev",
  "description": "Local, build-time CSS tooling for the Photoframe interface",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:fonts": "node ./scripts/build_ui_fonts.mjs",
    "build:css": "npm run build:fonts && tailwindcss -i ./assets/styles/v2.css -o ./src/photoframe/static/v2.css --minify"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@tailwindcss/cli": "4.3.3",
    "daisyui": "5.7.50",
    "tailwindcss": "4.3.3"
  }
}
